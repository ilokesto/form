{
  "name": "@ilokesto/form",
  "version": "2.0.2",
  "engines": {
    "node": ">=24.22.1"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "test:pack": "pnpm run build && node scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "test:tooling": "node --test --test-concurrency=1 tests/tooling/*.test.mjs",
    "docs:prepare": "pnpm build",
    "docs:dev": "pnpm docs:prepare && pnpm --dir website dev",
    "docs:build": "pnpm docs:prepare && pnpm --dir website build",
    "docs:typecheck": "pnpm docs:prepare && pnpm --dir website typecheck",
    "docs:test": "pnpm --dir website test",
    "docs:start": "pnpm --dir website start",
    "docs:publication:verify": "node scripts/docs-publication.mjs verify && node scripts/docs-runtime.mjs verify",
    "docs:publication:capture": "node scripts/docs-publication.mjs capture",
    "docs:publication:promote": "node scripts/docs-publication.mjs promote",
    "release:verify": "node scripts/release-verify.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "examples:build": "pnpm --workspace-concurrency=1 -r --filter './examples/*' run build",
    "examples:typecheck": "pnpm --workspace-concurrency=1 -r --filter './examples/*' run typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilokesto/form.git"
  },
  "homepage": "https://ilokesto.ayden94.com/en/form",
  "sideEffects": false,
  "keywords": [
    "form",
    "validation"
  ],
  "author": "Jeong Jinho <wpfekdml@me.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./vue": {
      "import": "./dist/vue/index.js",
      "types": "./dist/vue/index.d.ts"
    },
    "./solid": {
      "import": "./dist/solid/index.js",
      "types": "./dist/solid/index.d.ts"
    },
    "./svelte": {
      "import": "./dist/svelte/index.js",
      "types": "./dist/svelte/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "dependencies": {
    "@ilokesto/store": "2.0.1",
    "immer": "11.1.8"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "27.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "solid-js": "1.9.14",
    "svelte": "5.56.9",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue": "3.5.41",
    "@changesets/cli": "2.31.1",
    "yaml": "2.8.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "solid-js": "^1.9.0",
    "svelte": "^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.17.1"
}
